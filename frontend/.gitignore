# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Test-runner report artefacts. vitest's json reporter writes here by default, and the M16
# induced-violation harness reads that path. Left in the tree it showed up as an untracked file
# and failed `format:check`, so a tool that exists to verify the suite was itself breaking the gate.
.vitest/

# keep the environment example file under version control
!.env.example
